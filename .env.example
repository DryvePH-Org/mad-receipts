# Supabase (this app's own project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only

# Groq (voice: Whisper hears, gpt-oss reads)
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3         # optional; this is the default (more accurate for Filipino than -turbo)
GROQ_TRANSCRIPTION_LANGUAGE=                      # optional: leave empty for Taglish; tl or en forces one language
GROQ_REASONING_MODEL=openai/gpt-oss-120b          # optional; this is the default

# Groq vision (reads the car-document photos)
GROQ_VISION_MODEL=                                # a vision model from console.groq.com/docs
DOCS_READER=                                      # "grokbot": the grokbot reads the document photos (in the background, one job per car) instead of Groq/Grok. Empty = the picture API
XAI_API_KEY=                                      # optional: Grok (xAI) reads the car documents instead of Groq when set
XAI_VISION_MODEL=                                 # optional; default grok-4 (any xAI model that accepts pictures)
# Google (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GROKBOT_SCAN_WEBHOOK_URL=                        # the scanner bot's webhook (the bot that reads the car document photos)
GROKBOT_SCAN_WEBHOOK_SECRET=                     # its key, sent as a Bearer key
GROKBOT_SCAN_PARALLEL=                           # optional: how many scans may run at once (1 to 4, default 1)
GROKBOT_CALLBACK_SECRET=                         # any long random string: each job's answer token is derived from it
APP_BASE_URL=                                    # https://mad.dryveph.io: where the grokbot sends its answers
DOCS_BIBLE_DOCS_TAB=                             # the Docs Bible tab of the units; default "DOCS 2026" (a new year brings a new name)
DOCS_BIBLE_SHEET_ID=                              # the OLD Docs Bible sheet (shared by link): only the cut-over check reads it, to see if anyone typed in it after the move
SHEETS_WRITES=                                    # leave empty: Google Sheets are FROZEN (the receipts log and the inventory status wait). "on" lets them write. The Docs Bible is in the database and never goes to a sheet
GOOGLE_SHEET_ID=                    # receipts log sheet (separate from inventory)

# Google through an Apps Script web app (use this OR the service account above; see README)
APPS_SCRIPT_URL=                    # the Apps Script web app's /exec URL (the Drive folders and the old sheet connection)
APPS_SCRIPT_SECRET=                 # same value as the script's SECRET property

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Inventory = the Google Sheet staff already maintain

# Internal
CRON_SECRET=                        # protects /api/sync/run and /api/reminders/run
REPAIRS_TELEGRAM_BOT_TOKEN=         # the repairs bot's Telegram token (the existing bot); leave empty until the switch
REPAIRS_TELEGRAM_CHAT_ID=           # the repairs group's chat id (a negative number)
ANTHROPIC_API_KEY=                  # reads the repairmen's reports (Claude); without it the Groq model is used
REPAIRS_LLM_MODEL=                  # optional; default claude-haiku-5-5
ELEVENLABS_API_KEY=                 # voice notes of the repairs bot (stage 2)
REPAIRS_BOT_TOKEN=                  # the repairs bot's own secret for /api/repairs (leave empty until the bot is connected)

# Dashboard (Approver and Admin): the two Google Sheets, shared as "anyone with the link can view". These are the defaults; set to use other sheets.
# DASHBOARD_BUY_SHEET_ID=
# DASHBOARD_SELL_SHEET_ID=
# DASHBOARD_PENDING_DAYS=14   # how long a reservation may stay open when the sheet gives no cleaning date
# Optional: the full address of the ORCR WITH MAD tab (it stays in the old workbook for now); Car status shows a button to it
ORCR_SHEET_URL=
