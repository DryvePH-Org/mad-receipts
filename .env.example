# Supabase (this app's own project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only

# Groq (voice: Whisper hears, gpt-oss reads)
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3         # optional; this is the default (more accurate for Filipino than -turbo)
GROQ_TRANSCRIPTION_LANGUAGE=                      # optional: leave empty for Taglish; tl or en forces one language
GROQ_REASONING_MODEL=openai/gpt-oss-120b          # optional; this is the default

# Groq vision (reads the car-document photos)
GROQ_VISION_MODEL=                                # a vision model from console.groq.com/docs

# Google (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=                    # receipts log sheet (separate from inventory)

# Google through an Apps Script web app (use this OR the service account above; see README)
APPS_SCRIPT_URL=                    # the web app's /exec URL
APPS_SCRIPT_SECRET=                 # same value as the script's SECRET property

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Inventory = the Google Sheet staff already maintain
INVENTORY_SHEET_ID=
INVENTORY_SHEET_TAB=INVENTORY 2026
INVENTORY_PLATE_COLUMN=PLATE NUMBER   # header text of the plate column
INVENTORY_STATUS_COLUMN=REMARKS   # header text of the status column (staff write "RESERVED - NAME M/D" here)

# PCF (petty cash, the /pcf section)
PCF_DRIVE_FOLDER_ID=                # optional: Drive folder for voucher photo copies; add it to the script's ALLOWED_FOLDER_IDS too
RESEND_API_KEY=                     # optional, not used yet: PCF emails (approvals, replenishments, daily summary). Empty = email off
RESEND_FROM=                        # e.g. "MAD <noreply@dryve.ph>" once the domain is verified in Resend
APP_URL=https://invoice.dryveph.io  # base of the links in those emails
# NOTIFY_REDIRECT_TO=               # local testing only: send every petty cash email to this one address

# Internal
CRON_SECRET=                        # protects /api/sync/run, /api/reminders/run and /api/pcf/digest/run

# Dashboard (Approver and Admin): the two Google Sheets, shared as "anyone with the link can view". These are the defaults; set to use other sheets.
# DASHBOARD_BUY_SHEET_ID=
# DASHBOARD_SELL_SHEET_ID=
# DASHBOARD_PENDING_DAYS=14   # how long a reservation may stay open when the sheet gives no cleaning date
